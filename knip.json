{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src-tauri/**/*.rs"],
  "project": [
    "src/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "website/src/**/*.{ts,tsx}"
  ],
  "exclude": ["exports", "types"],
  "vite": {
    "config": ["vite.config.ts", "website/vite.config.ts"]
  },
  "ignoreBinaries": ["xcrun", "hdiutil", "pwsh"]
}
